# Application runtime: use Neon pooled URL, connected as the least-privilege
# `tether_app` role (created by migrations/0007_least_privilege_app_role.sql)
# rather than the Neon owner role — the owner role has BYPASSRLS, which makes
# every RLS policy in this schema silently inert. Set tether_app's password
# once via `ALTER ROLE tether_app WITH PASSWORD '...'` (not stored in any
# migration file) and use it here.
DATABASE_URL=postgresql://tether_app:password@ep-xxxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Migrations only: use the direct, non-pooler Neon URL, connected as the Neon
# owner role — DDL (CREATE TABLE/ALTER TABLE/CREATE POLICY) needs owner
# privileges that tether_app intentionally does not have.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require

# Clerk Dashboard → API Keys → Secret key. Keep this server-only; never place it
# in the Expo environment.
CLERK_SECRET_KEY=sk_test_replace_with_your_clerk_secret_key
# Optional: use this PEM public key for networkless JWT verification. Without it,
# Clerk's SDK obtains and caches the public keys from Clerk.
CLERK_JWT_KEY=-----BEGIN PUBLIC KEY-----\nreplace-with-your-jwt-public-key\n-----END PUBLIC KEY-----
# Comma-separated mobile/web origins, if your Clerk instance requires `azp` validation.
CLERK_AUTHORIZED_PARTIES=
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Google Cloud Console → APIs & Services → Places API (New, used by the
# /api/places/search, /lookup, and /photo endpoints). Keep this server-only;
# it is never sent to the mobile app, which calls our backend proxy instead.
GOOGLE_PLACES_API_KEY=replace_with_your_google_places_api_key

# Plaid Dashboard → Keys. Keep server-only; the access_token this exchanges
# for is never sent to the mobile app either (see /api/finances/plaid/*).
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Symmetric key for pgp_sym_encrypt/pgp_sym_decrypt of Plaid access tokens at
# rest (pgcrypto is already enabled by migrations/0001_initial_schema.sql).
# Generate with: openssl rand -base64 32
FINANCE_ENCRYPTION_KEY=
